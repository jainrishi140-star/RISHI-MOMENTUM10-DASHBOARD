//@version=6
// ADC TF backtester (TradingView strategy). Same signals as the ADC TF indicator:
//   Slow     : 30m timeframe  -> sign( LEAD(HLC3) - EMA(HLC3, 63) ), LEAD = EMA with factor 1.27
//   Fast     : 1m weighted blend of EMA(HLC3, n) - EMA(HLC3, 113)
//   Combined : takes a new side only when Slow and Fast agree. "Check signals only at 30-min marks"
//              (default on) checks it only at 09:45, 10:15 ... 15:15; off = every candle.
// Trades : every BUY goes long and every SELL goes short (always in the market), filled at the open of
//          the candle after the signal. Optional "Trend-gated shorts" (the Robust rule): a SELL is
//          shorted only when price is at or below the 30-day average of the signal prices, otherwise
//          the long is closed and the strategy stays flat until the next BUY.
// Use on a 1-minute NSE:NIFTY chart with Deep Backtesting. 1 crore x size multiplier per trade, so
// with multiplier 1 the Strategy Tester net profit / 1,00,000 = total ROI %.
strategy("ADC TF Backtester", shorttitle = "ADC TF BT", overlay = true, initial_capital = 10000000, default_qty_type = strategy.cash, default_qty_value = 10000000, commission_type = strategy.commission.percent, commission_value = 0, pyramiding = 0, margin_long = 0, margin_short = 0, max_labels_count = 500, max_lines_count = 50)

grpS = "Signal source"
useAlt = input.bool(false, "Compute signals on another symbol", group = grpS, tooltip = "Off = chart symbol (spot NSE:NIFTY). Turn on to run the same rules on another feed, e.g. NSE:NIFTY1!.")
altSym = input.symbol("NSE:NIFTY1!", "Signal symbol", group = grpS)

grpP = "Parameters"
slowTf    = input.timeframe("30", "Slow timeframe", group = grpP)
slowLen   = input.int(63, "Slow EMA length (HLC3)", minval = 1, group = grpP)
slowLead  = input.float(1.27, "Slow lead factor", minval = 1.0, step = 0.01, group = grpP)
lockChecks = input.bool(true, "Check signals only at 30-min marks (09:45-15:15)", group = grpP, tooltip = "On: Combined is checked only when a chart candle closes at 09:45, 10:15 ... 15:15 (exchange time); the next check after 15:15 is 09:45 the next day. Off: checked on every candle.")
fastTf    = input.timeframe("1", "Fast timeframe", group = grpP, tooltip = "Timeframe Fast is calculated on (default 1 minute). Leave empty to use the chart's timeframe.")

grpB = "Backtest"
fromTime = input.time(timestamp("03 Feb 2009 00:00 +0530"), "Backtest from", group = grpB)
toTime   = input.time(timestamp("31 Dec 2099 00:00 +0530"), "Backtest to", group = grpB)
sizeMult = input.float(1.0, "Position size multiplier", minval = 0.1, maxval = 5.0, step = 0.05, group = grpB, tooltip = "1 = 1 crore per trade.")
costPct  = input.float(0.0, "Cost per side for the tables (%)", minval = 0.0, step = 0.01, group = grpB, tooltip = "Used by the results and P&L tables. For the Strategy Tester set the same value as Commission in the strategy Properties.")
gateOn   = input.bool(false, "Trend-gated shorts (Robust rule)", group = grpB, tooltip = "On: a SELL is shorted only when price is at or below the trend average of the signal prices; above it the long is closed and the strategy stays flat until the next BUY.")
gateDays = input.int(30, "Trend average length (calendar days)", minval = 5, maxval = 365, group = grpB)

grpD = "Display"
showComb   = input.bool(true, "BUY / SELL labels", group = grpD)
showPrice  = input.bool(true, "Show price on labels", group = grpD)
showEma    = input.bool(true, "Plot Slow EMA (coloured by Slow)", group = grpD)
showRibbon = input.bool(true, "Trend ribbon (price to Slow EMA)", group = grpD)
showAvg    = input.bool(false, "Plot trend average (Robust rule)", group = grpD)
showEntry  = input.bool(true, "Entry line of the running trade", group = grpD)
bullCol    = input.color(#089981, "Bull colour", group = grpD, inline = "col")
bearCol    = input.color(#F23645, "Bear colour", group = grpD, inline = "col")
accentCol  = input.color(#5E35B1, "Header colour", group = grpD, inline = "col")

grpT = "Tables"
showTbl  = input.bool(true, "Status table (top right)", group = grpT)
showPnl  = input.bool(true, "Trade P&L table (bottom left)", group = grpT)
showRes  = input.bool(true, "Backtest results table (bottom right)", group = grpT)
tblSizeIn = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpT)

sym = useAlt ? altSym : syminfo.tickerid

leadEma(float src, float a) =>
    var float v = na
    v := na(v) ? src : a * src + (1 - a) * v
    v

slowState() => math.sign(leadEma(hlc3, slowLead) - ta.ema(hlc3, slowLen))
slowEma()   => ta.ema(hlc3, slowLen)

// Weights fitted on the 30m + 5m charts and validated on the 3m and 1m charts
fastState() =>
    float b = ta.ema(hlc3, 113)
    float score = 0.0128 * (hlc3 - b) - 0.0381 * (ta.ema(hlc3, 5) - b) + 0.0198 * (ta.ema(hlc3, 10) - b) + 0.1147 * (ta.ema(hlc3, 20) - b) - 0.6092 * (ta.ema(hlc3, 40) - b) + 0.5811 * (ta.ema(hlc3, 60) - b) + 1.0 * (ta.ema(hlc3, 80) - b) + 0.4886 * (ta.ema(hlc3, 100) - b) - 0.2437 * (ta.ema(hlc3, 120) - b) - 0.7241 * (ta.ema(hlc3, 140) - b) - 0.8173 * (ta.ema(hlc3, 160) - b) - 0.1915 * (ta.ema(hlc3, 200) - b) + 0.5852 * (ta.ema(hlc3, 250) - b) - 0.1643 * (ta.ema(hlc3, 300) - b)
    math.sign(score)

// Slow: the 30m value appears on the chart candle that closes with the 30m candle (e.g. the 09:44
// candle on a 1m chart, closing at 09:45), as the TK TF Original System shows it.
float slow = request.security(sym, slowTf, slowState())
float slowLine = request.security(sym, slowTf, slowEma())

// Fast: when locked to a timeframe below the chart's, read every intrabar Fast value and replay
// the Combined rule bar by bar, so Combined matches what the locked timeframe's chart would show.
// Inside a chart bar, Slow keeps its previous value until the last intrabar, the one that closes
// the 30m candle (exact for charts from 1m to 30m).
string fastReqTf  = fastTf == "" or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(fastTf) ? timeframe.period : fastTf
bool   fastLocked = fastReqTf != timeframe.period
float  fastChart  = request.security(sym, timeframe.period, fastState())
array<float> fastIntra = request.security_lower_tf(sym, fastReqTf, fastState())

var float fast     = na
var float combFree = 0.0  // checked on every (intrabar) candle, like the TK TF Original System
if fastLocked
    int n = array.size(fastIntra)
    if n > 0
        for i = 0 to n - 1
            float f = array.get(fastIntra, i)
            float s = i == n - 1 ? slow : nz(slow[1])
            if s == f and s != 0
                combFree := s
        fast := array.get(fastIntra, n - 1)
else
    fast := fastChart
    if slow == fast and slow != 0
        combFree := slow

// Fixed check times: the chart candle that closes at 09:45, 10:15 ... 15:15 exchange time
int  closeMin = hour(time_close, "Asia/Kolkata") * 60 + minute(time_close, "Asia/Kolkata")
bool isCheck  = closeMin >= 585 and closeMin <= 915 and (closeMin - 585) % 30 == 0

var float comb = 0.0
if lockChecks
    if isCheck and slow == fast and slow != 0
        comb := slow
else
    comb := combFree

flipUp(float s) => s == 1 and nz(s[1]) == -1
flipDn(float s) => s == -1 and nz(s[1]) == 1

combBuy  = flipUp(comb)
combSell = flipDn(comb)
slowBuy  = flipUp(slow)
slowSell = flipDn(slow)
fastBuy  = flipUp(fast)
fastSell = flipDn(fast)

// ---------- Trend average of the signal prices (Robust rule) ----------
// Every Combined signal is recorded at its fill (time and open of the candle after the signal). The
// average weights each signal price by how long it stood over the last gateDays calendar days; it is
// na until that much history exists (shorts are then taken).
var array<int>   flipT = array.new<int>()
var array<float> flipP = array.new<float>()
if nz(comb[1]) != nz(comb[2]) and nz(comb[1]) != 0
    array.push(flipT, time)
    array.push(flipP, open)
    if array.size(flipT) > 2000
        array.shift(flipT)
        array.shift(flipP)

flipAvg(array<int> ts, array<float> ps, int nowT, int days) =>
    int lo = nowT - days * 86400000
    int n = array.size(ts)
    float num = 0.0
    float den = 0.0
    bool full = false
    if n > 0
        int segEnd = nowT
        for i = n - 1 to 0
            int t0 = array.get(ts, i)
            int a = math.max(t0, lo)
            if segEnd > a
                num += array.get(ps, i) * (segEnd - a)
                den += segEnd - a
            segEnd := t0
            if t0 <= lo
                full := true
                break
    full and den > 0 ? num / den : na

var float trendAvg = na
if combBuy or combSell
    trendAvg := flipAvg(flipT, flipP, time_close, gateDays)
bool gated = gateOn and combSell and not na(trendAvg) and close > trendAvg

// ---------- Orders ----------
bool  inRange = time >= fromTime and time <= toTime
float qty     = sizeMult * 10000000 / close
if inRange and combBuy
    strategy.entry("Long", strategy.long, qty = qty)
if inRange and combSell
    if gated
        strategy.close("Long", comment = "Flat (uptrend)")
    else
        strategy.entry("Short", strategy.short, qty = qty)
if time > toTime and strategy.position_size != 0
    strategy.close_all(comment = "End of test")

// ---------- Look ----------
color neutCol = #787B86
color lblBg   = #FFFFFF
color lblTx   = #131722
string tblSize = tblSizeIn == "Tiny" ? size.tiny : tblSizeIn == "Small" ? size.small : tblSizeIn == "Large" ? size.large : size.normal
stateCol(float s) => s == 1 ? bullCol : s == -1 ? bearCol : neutCol
stateText(float s) => s == 1 ? "▲ BULL" : s == -1 ? "▼ BEAR" : "–"

color combCol = stateCol(comb)
color emaCol  = stateCol(slow)

plot(showEma ? slowLine : na, "Slow EMA glow", color = color.new(emaCol, 80), linewidth = 6, display = display.pane)
pEma   = plot(slowLine, "Slow EMA (30m HLC3)", color = showEma ? emaCol : na, linewidth = 2)
pPrice = plot(close, "Price (ribbon)", color = na, display = display.none, editable = false)
fill(pEma, pPrice, color = showRibbon ? color.new(combCol, 85) : na, title = "Trend ribbon")
plot(showAvg ? trendAvg : na, "Trend average", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_stepline)

if showComb and inRange and combBuy
    label.new(bar_index, low, "BUY" + (showPrice ? "\n" + str.tostring(close, "#,##0.00") : ""), style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.small, yloc = yloc.belowbar)
if showComb and inRange and combSell
    label.new(bar_index, high, (gated ? "FLAT" : "SELL") + (showPrice ? "\n" + str.tostring(close, "#,##0.00") : ""), style = label.style_label_down, color = gated ? neutCol : bearCol, textcolor = color.white, size = size.small, yloc = yloc.abovebar)

plot(slow, "Slow", display = display.data_window)
plot(fast, "Fast", display = display.data_window)
plot(comb, "Combined", display = display.data_window)

// ---------- Trade log (drives both tables) ----------
// Mirrors the orders above: at the candle after a signal the open trade (if any) is closed at the
// open and the new side (long, short or flat) starts at the same open.
type Stats
    int   n       = 0
    int   wins    = 0
    int   nLong   = 0
    int   nShort  = 0
    float sum     = 0.0
    float sumL    = 0.0
    float sumS    = 0.0
    float pts     = 0.0
    float gw      = 0.0
    float gl      = 0.0
    float peak    = 0.0
    float dd      = 0.0
    float eq      = 1.0
    float eqPeak  = 1.0
    float cdd     = 0.0
    float best    = na
    float worst   = na
    int   streak  = 0
    int   maxLose = 0

method add(Stats s, int side, float r, float p) =>
    s.n := s.n + 1
    s.sum := s.sum + r
    s.pts := s.pts + p
    if side == 1
        s.nLong := s.nLong + 1
        s.sumL := s.sumL + r
    else
        s.nShort := s.nShort + 1
        s.sumS := s.sumS + r
    if r > 0
        s.wins := s.wins + 1
        s.gw := s.gw + r
        s.streak := 0
    else
        s.gl := s.gl - r
        s.streak := s.streak + 1
        s.maxLose := math.max(s.maxLose, s.streak)
    s.best := na(s.best) ? r : math.max(s.best, r)
    s.worst := na(s.worst) ? r : math.min(s.worst, r)
    s.peak := math.max(s.peak, s.sum)
    s.dd := math.max(s.dd, s.peak - s.sum)
    s.eq := s.eq * (1 + r / 100)
    s.eqPeak := math.max(s.eqPeak, s.eq)
    s.cdd := math.max(s.cdd, (s.eqPeak - s.eq) / s.eqPeak * 100)

var Stats st = Stats.new()
var int   trSide   = 0       // 1 long, -1 short, 0 flat
var float trEntry  = na
var float trSize   = 1.0
var int   pendAct  = 0       // 1 go long, -1 go short, 2 go flat
var float runPeak  = 0.0
var float runDD    = 0.0
var array<float> clPts = array.new<float>()
var array<float> clRoi = array.new<float>()
var array<int>   clT   = array.new<int>()
var line  entryLn  = na
var int   firstT   = na
var int   lastT    = na
var int   chartT0  = time

if pendAct != 0
    if trSide != 0
        float p = trSide * (open - trEntry)
        float r = trSize * (p / trEntry * 100 - 2 * costPct)
        st.add(trSide, r, p)
        array.push(clPts, p)
        array.push(clRoi, r)
        array.push(clT, time)
        if array.size(clPts) > 3000
            array.shift(clPts)
            array.shift(clRoi)
            array.shift(clT)
        lastT := time
    if na(firstT)
        firstT := time
    trSide := pendAct == 2 ? 0 : pendAct
    trEntry := open
    trSize := sizeMult
    runPeak := 0.0
    runDD := 0.0
    pendAct := 0
    line.delete(entryLn)
    if showEntry and trSide != 0
        entryLn := line.new(bar_index, trEntry, bar_index + 1, trEntry, extend = extend.right, color = color.new(stateCol(trSide), 20), style = line.style_dashed, width = 1)
if trSide != 0
    float worstPts = trSide == 1 ? low - trEntry : trEntry - high
    float bestPts  = trSide == 1 ? high - trEntry : trEntry - low
    runDD := math.max(runDD, runPeak - worstPts)
    runPeak := math.max(runPeak, bestPts)
if inRange and combBuy
    pendAct := 1
if inRange and combSell
    pendAct := gated ? (trSide != 0 ? 2 : 0) : -1
if time > toTime and trSide != 0 and pendAct == 0
    pendAct := 2

// ---------- Helpers ----------
seqStats(int i0, bool addRunning, float curPts, float curRoi) =>
    float cp = 0.0
    float cr = 0.0
    float pkP = 0.0
    float pkR = 0.0
    float ddP = 0.0
    float ddR = 0.0
    int n = 0
    int sz = array.size(clPts)
    if i0 < sz
        for i = i0 to sz - 1
            cp += array.get(clPts, i)
            cr += array.get(clRoi, i)
            pkP := math.max(pkP, cp)
            pkR := math.max(pkR, cr)
            ddP := math.max(ddP, pkP - cp)
            ddR := math.max(ddR, pkR - cr)
            n += 1
    if addRunning and not na(curPts)
        cp += curPts
        cr += curRoi
        ddP := math.max(ddP, pkP - cp)
        ddR := math.max(ddR, pkR - cr)
        n += 1
    [cp, cr, ddP, ddR, n]

firstIdxSince(int fromT) =>
    int sz = array.size(clT)
    int idx = sz
    if sz > 0
        for i = sz - 1 to 0
            if array.get(clT, i) < fromT
                break
            idx := i
    idx

pnlText(float v) => na(v) ? "–" : (v > 0 ? "+" : "") + str.tostring(v, "#,##0.00")
pnlCol(float v) => na(v) or v == 0 ? neutCol : v > 0 ? bullCol : bearCol
ddText(float v) => na(v) ? "–" : v > 0 ? "-" + str.tostring(v, "#,##0.00") : "0.00"
ddCol(float v) => na(v) or v <= 0 ? neutCol : color.new(bearCol, 15)

headCell(table t, int c, int r, string txt) =>
    table.cell(t, c, r, txt, text_color = color.white, bgcolor = accentCol, text_size = tblSize, text_formatting = text.format_bold)
labelCell(table t, int c, int r, string txt) =>
    table.cell(t, c, r, txt, text_color = lblTx, bgcolor = lblBg, text_size = tblSize, text_halign = text.align_left, text_formatting = text.format_bold)
valueCell(table t, int c, int r, string txt, color bg) =>
    table.cell(t, c, r, txt, text_color = color.white, bgcolor = bg, text_size = tblSize, text_formatting = text.format_bold)

// ---------- Status table (top right) ----------
var table tbl = table.new(position.top_right, 2, 4, frame_color = accentCol, frame_width = 2, border_color = color.new(accentCol, 60), border_width = 1)
if showTbl and barstate.islast
    headCell(tbl, 0, 0, "ADC TF")
    headCell(tbl, 1, 0, syminfo.ticker)
    labelCell(tbl, 0, 1, "Slow")
    valueCell(tbl, 1, 1, stateText(slow), stateCol(slow))
    labelCell(tbl, 0, 2, "Fast")
    valueCell(tbl, 1, 2, stateText(fast), stateCol(fast))
    labelCell(tbl, 0, 3, "Combined")
    valueCell(tbl, 1, 3, stateText(comb), stateCol(comb))

// ---------- Trade P&L table (bottom left) ----------
var table pnl = table.new(position.bottom_left, 6, 7, frame_color = accentCol, frame_width = 2, border_color = color.new(accentCol, 60), border_width = 1)

pnlRow(int r, string name, float pts, float roi, float ddP, float ddR, int n) =>
    labelCell(pnl, 0, r, name)
    valueCell(pnl, 1, r, str.tostring(n), accentCol)
    valueCell(pnl, 2, r, n > 0 ? pnlText(pts) : "–", n > 0 ? pnlCol(pts) : neutCol)
    valueCell(pnl, 3, r, n > 0 ? pnlText(roi) : "–", n > 0 ? pnlCol(roi) : neutCol)
    valueCell(pnl, 4, r, n > 0 ? ddText(ddP) : "–", n > 0 ? ddCol(ddP) : neutCol)
    valueCell(pnl, 5, r, n > 0 ? ddText(ddR) : "–", n > 0 ? ddCol(ddR) : neutCol)

if showPnl and barstate.islast
    float curPts = trSide != 0 ? trSide * (close - trEntry) : na
    float curRoi = trSide != 0 ? trSize * curPts / trEntry * 100 : na
    int   sz     = array.size(clPts)
    string sideTxt = trSide == 1 ? "▲ LONG" : trSide == -1 ? "▼ SHORT" : "FLAT"
    headCell(pnl, 0, 0, "ADC TF trades")
    headCell(pnl, 1, 0, "Trades")
    headCell(pnl, 2, 0, "Points")
    headCell(pnl, 3, 0, "ROI %")
    headCell(pnl, 4, 0, "Max DD pts")
    headCell(pnl, 5, 0, "Max DD %")
    pnlRow(1, "Running " + sideTxt + (trSide != 0 ? " @ " + str.tostring(trEntry, "#,##0.00") : ""), curPts, curRoi, trSide != 0 ? runDD : na, trSide != 0 ? trSize * runDD / trEntry * 100 : na, trSide != 0 ? 1 : 0)
    [p3, r3, d3p, d3r, n3] = seqStats(math.max(sz - 3, 0), false, na, na)
    pnlRow(2, "Last 3 closed trades", p3, r3, d3p, d3r, n3)
    [p5, r5, d5p, d5r, n5] = seqStats(math.max(sz - 5, 0), false, na, na)
    pnlRow(3, "Last 5 closed trades", p5, r5, d5p, d5r, n5)
    string since = str.format_time(chartT0, "dd MMM yyyy", "Asia/Kolkata")
    for [k, days] in array.from(7, 30, 91)
        int fromT = time - days * 86400000
        [wp, wr, wdp, wdr, wn] = seqStats(firstIdxSince(fromT), true, curPts, curRoi)
        string nm = days == 7 ? "Week (7 days)" : days == 30 ? "Month (30 days)" : "Quarter (91 days)"
        pnlRow(4 + k, nm + (fromT < chartT0 ? " – since " + since : ""), wp, wr, wdp, wdr, wn)

// ---------- Backtest results table (bottom right) ----------
var table res = table.new(position.bottom_right, 2, 15, frame_color = accentCol, frame_width = 2, border_color = color.new(accentCol, 60), border_width = 1)

resRow(int r, string name, string val, color bg) =>
    labelCell(res, 0, r, name)
    valueCell(res, 1, r, val, bg)

fmtv(float v, string f) => na(v) ? "–" : str.tostring(v, f)

if showRes and barstate.islast
    float years = na(firstT) or na(lastT) or lastT <= firstT ? na : (lastT - firstT) / (365.25 * 86400000.0)
    float pf    = st.gl > 0 ? st.gw / st.gl : na
    float cagr  = na(years) ? na : (math.pow(st.eq, 1 / years) - 1) * 100
    string mode = (lockChecks ? "30-min checks" : "Every candle") + (gateOn ? " + Robust" : "")
    headCell(res, 0, 0, "ADC TF backtest")
    headCell(res, 1, 0, mode)
    resRow(1, "Period", na(firstT) ? "–" : str.format_time(firstT, "dd MMM yyyy", "Asia/Kolkata") + " → " + (na(lastT) ? "–" : str.format_time(lastT, "dd MMM yyyy", "Asia/Kolkata")), accentCol)
    resRow(2, "Closed trades (long / short)", str.tostring(st.n) + " (" + str.tostring(st.nLong) + " / " + str.tostring(st.nShort) + ")", accentCol)
    resRow(3, "Total ROI %", fmtv(st.sum, "#,##0.00"), pnlCol(st.sum))
    resRow(4, "ROI per year %", fmtv(na(years) ? na : st.sum / years, "#,##0.00"), pnlCol(st.sum))
    resRow(5, "CAGR % (compounded)", fmtv(cagr, "#,##0.00"), pnlCol(cagr))
    resRow(6, "Max drawdown % (ROI)", st.n > 0 ? ddText(st.dd) : "–", ddCol(st.dd))
    resRow(7, "Max drawdown % (compounded)", st.n > 0 ? ddText(st.cdd) : "–", ddCol(st.cdd))
    resRow(8, "Profit factor", fmtv(pf, "#.##"), na(pf) ? neutCol : pf >= 1 ? bullCol : bearCol)
    resRow(9, "Win rate %", fmtv(st.n > 0 ? 100.0 * st.wins / st.n : na, "#.#"), accentCol)
    resRow(10, "Avg ROI per trade %", fmtv(st.n > 0 ? st.sum / st.n : na, "#.###"), pnlCol(st.sum))
    resRow(11, "Total points (per unit)", fmtv(st.pts, "#,##0.00"), pnlCol(st.pts))
    resRow(12, "Long ROI % / Short ROI %", fmtv(st.sumL, "#,##0.00") + " / " + fmtv(st.sumS, "#,##0.00"), accentCol)
    resRow(13, "Best / worst trade %", fmtv(st.best, "#.##") + " / " + fmtv(st.worst, "#.##"), accentCol)
    resRow(14, "Longest losing streak", str.tostring(st.maxLose) + " trades", accentCol)
