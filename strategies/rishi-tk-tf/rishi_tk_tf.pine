//@version=6
// Rishi TK TF: our in-house Slow / Fast / Combined system, built by reverse-engineering the
// TK TF Original System (TK ALGO V1.1) from its TradingView exports and 2009-2026 trade logs
// (see README.md in this folder). All changes are made here; the TK TF Original System is untouched.
//
//   Slow     : 30m timeframe  -> sign( LEAD(HLC3) - EMA(HLC3, 63) )
//              LEAD is an EMA with smoothing factor 1.27 (> 1), so it leads price instead of lagging
//   Fast     : sign of a fixed weighted sum of EMA(HLC3, n) - EMA(HLC3, 113), on the "Fast timeframe"
//              (default 1 minute, as in the TK TF Original System's logs; empty = chart timeframe)
//   Combined : takes a new side only when Slow and Fast agree, otherwise keeps the previous side.
//              With "Check signals only at 30-min marks" on (default), this is checked only at
//              09:45, 10:15 ... 15:15; the next check after 15:15 is 09:45 the next day.
//
// Use on a 1m-30m chart of NSE:NIFTY. Signals are final when the candle closes: set alerts to
// "Once Per Bar Close".
indicator("Rishi TK TF (Slow / Fast / Combined)", shorttitle = "Rishi TK TF", overlay = true)

grpS = "Signal source"
useAlt = input.bool(false, "Compute signals on another symbol", group = grpS, tooltip = "Off = chart symbol (the TK TF Original System's logs match spot NSE:NIFTY). Turn on to run the same rules on another feed, e.g. NSE:NIFTY1!.")
altSym = input.symbol("NSE:NIFTY1!", "Signal symbol", group = grpS)

grpP = "Parameters"
slowTf    = input.timeframe("30", "Slow timeframe", group = grpP)
slowLen   = input.int(63, "Slow EMA length (HLC3)", minval = 1, group = grpP)
slowLead  = input.float(1.27, "Slow lead factor", minval = 1.0, step = 0.01, group = grpP)
lockChecks = input.bool(true, "Check signals only at 30-min marks (09:45-15:15)", group = grpP, tooltip = "On: Combined is checked only when a chart candle closes at 09:45, 10:15, 10:45 ... 15:15 (exchange time). Changes between checks, or after 15:15, wait for the next check (next day 09:45). Off: checked on every candle, like the TK TF Original System.")
fastTf    = input.timeframe("1", "Fast timeframe", group = grpP, tooltip = "Timeframe Fast is calculated on. Default 1 minute, the timeframe of the TK TF Original System's trade logs, so Fast and Combined stay the same on any chart from 1m to 30m. Leave empty to use the chart's timeframe, as the TK TF Original System does.")

grpD = "Display"
showSlow = input.bool(false, "Slow signals", group = grpD, inline = "sig")
showFast = input.bool(false, "Fast signals", group = grpD, inline = "sig")
showComb = input.bool(true, "Combined signals", group = grpD, inline = "sig")
showEma  = input.bool(true, "Plot Slow EMA", group = grpD)
showBg   = input.bool(true, "Shade Combined state", group = grpD)
showTbl  = input.bool(true, "Status table", group = grpD)
showPnl  = input.bool(true, "Trade P&L table (bottom left)", group = grpD, tooltip = "Combined trades: always in the market, each BUY / SELL reverses, filled at the open of the candle after the signal (same as the trade logs). Points are NIFTY points per 1 unit; ROI % is points / entry price. Rolling rows add up the last 3 / last 5 closed trades. Best on a 1m chart.")

sym = useAlt ? altSym : syminfo.tickerid

leadEma(float src, float a) =>
    var float v = na
    v := na(v) ? src : a * src + (1 - a) * v
    v

slowState() => math.sign(leadEma(hlc3, slowLead) - ta.ema(hlc3, slowLen))
slowEma()   => ta.ema(hlc3, slowLen)

// Weights fitted on the 30m + 5m charts and validated on the 3m and 1m charts
fastState() =>
    float b = ta.ema(hlc3, 113)
    float score = 0.0128 * (hlc3 - b) - 0.0381 * (ta.ema(hlc3, 5) - b) + 0.0198 * (ta.ema(hlc3, 10) - b) + 0.1147 * (ta.ema(hlc3, 20) - b) - 0.6092 * (ta.ema(hlc3, 40) - b) + 0.5811 * (ta.ema(hlc3, 60) - b) + 1.0 * (ta.ema(hlc3, 80) - b) + 0.4886 * (ta.ema(hlc3, 100) - b) - 0.2437 * (ta.ema(hlc3, 120) - b) - 0.7241 * (ta.ema(hlc3, 140) - b) - 0.8173 * (ta.ema(hlc3, 160) - b) - 0.1915 * (ta.ema(hlc3, 200) - b) + 0.5852 * (ta.ema(hlc3, 250) - b) - 0.1643 * (ta.ema(hlc3, 300) - b)
    math.sign(score)

// Slow: the 30m value appears on the chart candle that closes with the 30m candle (e.g. the 09:44
// candle on a 1m chart, closing at 09:45), as the TK TF Original System shows it.
float slow = request.security(sym, slowTf, slowState())
float slowLine = request.security(sym, slowTf, slowEma())

// Fast: when locked to a timeframe below the chart's, read every intrabar Fast value and replay
// the Combined rule bar by bar, so Combined matches what the locked timeframe's chart would show.
// Inside a chart bar, Slow keeps its previous value until the last intrabar, the one that closes
// the 30m candle (exact for charts from 1m to 30m).
string fastReqTf  = fastTf == "" or timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(fastTf) ? timeframe.period : fastTf
bool   fastLocked = fastReqTf != timeframe.period
float  fastChart  = request.security(sym, timeframe.period, fastState())
array<float> fastIntra = request.security_lower_tf(sym, fastReqTf, fastState())

var float fast     = na
var float combFree = 0.0  // checked on every (intrabar) candle, like the TK TF Original System
if fastLocked
    int n = array.size(fastIntra)
    if n > 0
        for i = 0 to n - 1
            float f = array.get(fastIntra, i)
            float s = i == n - 1 ? slow : nz(slow[1])
            if s == f and s != 0
                combFree := s
        fast := array.get(fastIntra, n - 1)
else
    fast := fastChart
    if slow == fast and slow != 0
        combFree := slow

// Fixed check times: the chart candle that closes at 09:45, 10:15 ... 15:15 exchange time
int  closeMin = hour(time_close, "Asia/Kolkata") * 60 + minute(time_close, "Asia/Kolkata")
bool isCheck  = closeMin >= 585 and closeMin <= 915 and (closeMin - 585) % 30 == 0

var float comb = 0.0
if lockChecks
    if isCheck and slow == fast and slow != 0
        comb := slow
else
    comb := combFree

flipUp(float s) => s == 1 and nz(s[1]) == -1
flipDn(float s) => s == -1 and nz(s[1]) == 1

combBuy  = flipUp(comb)
combSell = flipDn(comb)
slowBuy  = flipUp(slow)
slowSell = flipDn(slow)
fastBuy  = flipUp(fast)
fastSell = flipDn(fast)

plot(showEma ? slowLine : na, "Slow EMA (30m HLC3)", color = color.new(color.orange, 0), linewidth = 2)
bgcolor(showBg and comb == 1 ? color.new(color.teal, 90) : showBg and comb == -1 ? color.new(color.red, 90) : na)

plotshape(showComb and combBuy,  "Combined BUY",  shape.labelup,   location.belowbar, color.new(color.teal, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(showComb and combSell, "Combined SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),  text = "SELL", textcolor = color.white, size = size.small)
plotshape(showSlow and slowBuy,  "Slow BUY",  shape.triangleup,   location.belowbar, color.new(color.blue, 0),   text = "S", size = size.tiny)
plotshape(showSlow and slowSell, "Slow SELL", shape.triangledown, location.abovebar, color.new(color.maroon, 0), text = "S", size = size.tiny)
plotshape(showFast and fastBuy,  "Fast BUY",  shape.circle, location.belowbar, color.new(color.aqua, 0),   text = "F", size = size.tiny)
plotshape(showFast and fastSell, "Fast SELL", shape.circle, location.abovebar, color.new(color.fuchsia, 0), text = "F", size = size.tiny)

// Hidden plots so the values appear in the Data Window and CSV export, for comparison with TK TF Original
plot(slow, "Slow", display = display.data_window)
plot(fast, "Fast", display = display.data_window)
plot(comb, "Combined", display = display.data_window)

alertcondition(combBuy,  "Combined BUY",  "Rishi TK TF: Combined BUY on {{ticker}} at {{close}}")
alertcondition(combSell, "Combined SELL", "Rishi TK TF: Combined SELL on {{ticker}} at {{close}}")
alertcondition(slowBuy,  "Slow BUY",  "Rishi TK TF: Slow BUY on {{ticker}} at {{close}}")
alertcondition(slowSell, "Slow SELL", "Rishi TK TF: Slow SELL on {{ticker}} at {{close}}")

stateText(float s) => s == 1 ? "BULL" : s == -1 ? "BEAR" : "-"
stateColor(float s) => s == 1 ? color.teal : s == -1 ? color.red : color.gray

var table tbl = table.new(position.top_right, 2, 4, border_width = 1)
if showTbl and barstate.islast
    table.cell(tbl, 0, 0, "Rishi TK TF", text_color = color.white, bgcolor = color.purple)
    table.cell(tbl, 1, 0, sym, text_color = color.white, bgcolor = color.purple)
    table.cell(tbl, 0, 1, "Slow (" + slowTf + ")")
    table.cell(tbl, 1, 1, stateText(slow), text_color = color.white, bgcolor = stateColor(slow))
    table.cell(tbl, 0, 2, "Fast (" + (fastLocked ? fastReqTf : "chart") + ")")
    table.cell(tbl, 1, 2, stateText(fast), text_color = color.white, bgcolor = stateColor(fast))
    table.cell(tbl, 0, 3, "Combined")
    table.cell(tbl, 1, 3, stateText(comb), text_color = color.white, bgcolor = stateColor(comb))

// ---------- Trade P&L table (bottom left) ----------
// Combined trades as in the trade logs: always in the market, every BUY / SELL reverses the
// position, filled at the open of the candle after the signal.
var int   trSide   = 0
var float trEntry  = na
var int   pendSide = 0
var array<float> clPts = array.new<float>()
var array<float> clRoi = array.new<float>()

if pendSide != 0
    if trSide != 0
        float p = trSide * (open - trEntry)
        array.push(clPts, p)
        array.push(clRoi, p / trEntry * 100)
        if array.size(clPts) > 5
            array.shift(clPts)
            array.shift(clRoi)
    trSide := pendSide
    trEntry := open
    pendSide := 0
if combBuy
    pendSide := 1
if combSell
    pendSide := -1

lastSum(array<float> a, int k) =>
    int n = array.size(a)
    int m = math.min(k, n)
    float s = 0.0
    if m > 0
        for i = n - m to n - 1
            s += array.get(a, i)
    [s, m]

pnlText(float v) => na(v) ? "-" : (v > 0 ? "+" : "") + str.tostring(v, "#,##0.00")
pnlColor(float v) => na(v) or v == 0 ? color.gray : v > 0 ? color.teal : color.red

var table pnl = table.new(position.bottom_left, 3, 4, border_width = 1)
if showPnl and barstate.islast
    float curPts = trSide != 0 ? trSide * (close - trEntry) : na
    float curRoi = trSide != 0 ? curPts / trEntry * 100 : na
    [p3, n3] = lastSum(clPts, 3)
    [r3, k3] = lastSum(clRoi, 3)
    [p5, n5] = lastSum(clPts, 5)
    [r5, k5] = lastSum(clRoi, 5)
    string sideTxt = trSide == 1 ? "LONG" : trSide == -1 ? "SHORT" : "-"
    table.cell(pnl, 0, 0, "Rishi TK TF trades", text_color = color.white, bgcolor = color.purple)
    table.cell(pnl, 1, 0, "Points", text_color = color.white, bgcolor = color.purple)
    table.cell(pnl, 2, 0, "ROI %", text_color = color.white, bgcolor = color.purple)
    table.cell(pnl, 0, 1, "Running " + sideTxt + (trSide != 0 ? " @ " + str.tostring(trEntry, "#,##0.00") : ""), text_color = color.black, bgcolor = color.white, text_formatting = text.format_bold)
    table.cell(pnl, 1, 1, pnlText(curPts), text_color = color.white, bgcolor = pnlColor(curPts), text_formatting = text.format_bold)
    table.cell(pnl, 2, 1, pnlText(curRoi), text_color = color.white, bgcolor = pnlColor(curRoi), text_formatting = text.format_bold)
    table.cell(pnl, 0, 2, "Last 3 closed trades" + (n3 < 3 ? " (" + str.tostring(n3) + ")" : ""), text_color = color.black, bgcolor = color.white, text_formatting = text.format_bold)
    table.cell(pnl, 1, 2, n3 > 0 ? pnlText(p3) : "-", text_color = color.white, bgcolor = n3 > 0 ? pnlColor(p3) : color.gray, text_formatting = text.format_bold)
    table.cell(pnl, 2, 2, n3 > 0 ? pnlText(r3) : "-", text_color = color.white, bgcolor = n3 > 0 ? pnlColor(r3) : color.gray, text_formatting = text.format_bold)
    table.cell(pnl, 0, 3, "Last 5 closed trades" + (n5 < 5 ? " (" + str.tostring(n5) + ")" : ""), text_color = color.black, bgcolor = color.white, text_formatting = text.format_bold)
    table.cell(pnl, 1, 3, n5 > 0 ? pnlText(p5) : "-", text_color = color.white, bgcolor = n5 > 0 ? pnlColor(p5) : color.gray, text_formatting = text.format_bold)
    table.cell(pnl, 2, 3, n5 > 0 ? pnlText(r5) : "-", text_color = color.white, bgcolor = n5 > 0 ? pnlColor(r5) : color.gray, text_formatting = text.format_bold)
